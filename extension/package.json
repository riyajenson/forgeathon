{
  "name": "forgeathon-editor",
  "displayName": "Forge-a-thon Editor",
  "description": "VS Code editor client for the Forge-a-thon TrueForge agent.",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ."
  },
  "contributes": {
    "commands": [
      {
        "command": "forgeathon.inlineEdit",
        "title": "Forge-a-thon: Inline Edit"
      },
      {
        "command": "forgeathon.openAgentPanel",
        "title": "Forge-a-thon: Open Agent Panel"
      },
      {
        "command": "forgeathon.reviewHunks",
        "title": "Forge-a-thon: Review Hunks"
      },
      {
        "command": "forgeathon.acceptAllHunks",
        "title": "Forge-a-thon: Accept All Hunks"
      },
      {
        "command": "forgeathon.rejectAllHunks",
        "title": "Forge-a-thon: Reject All Hunks"
      },
      {
        "command": "forgeathon.undo",
        "title": "Forge-a-thon: Undo Last Reviewed Edit"
      },
      {
        "command": "forgeathon.stop",
        "title": "Forge-a-thon: Stop Turn"
      }
    ],
    "keybindings": [
      {
        "command": "forgeathon.inlineEdit",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus && editorHasSelection && !editorReadonly && isWorkspaceTrusted"
      }
    ],
    "configuration": {
      "title": "Forge",
      "properties": {
        "forge.trueforgeUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8790",
          "scope": "machine",
          "description": "Local TrueForge server in the extension host environment."
        },
        "forge.mcpPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 47615,
          "scope": "machine",
          "description": "Loopback port used by the editor MCP server."
        },
        "forge.context.budgetTokens": {
          "type": "integer",
          "minimum": 1,
          "default": 8000,
          "description": "Agent-mode context budget in tokens."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "2.5.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "forge-harness": "file:../src/harness"
  },
  "extensionKind": [
    "workspace"
  ]
}
