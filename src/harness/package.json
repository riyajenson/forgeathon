{
  "name": "forge-harness",
  "version": "0.0.1",
  "private": true,
  "description": "TrueForge harness for the Forge-a-thon VS Code agent: MCP editor tools, review core, TrueForge adapter.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
