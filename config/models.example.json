{
  "$comment": "Copy to config/models.json (gitignored) and edit. API keys are read from the environment variables named in apiKeyEnv; never put keys in this file. Model names in 'agents' are '<provider name>/<model name>'. The fallback must use a different provider than the primary.",
  "providers": [
    {
      "type": "anthropic",
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "models": [
        { "name": "claude-sonnet-5-5", "modelId": "claude-sonnet-5-5", "contextLength": 200000, "maxOutputTokens": 8192 }
      ]
    },
    {
      "type": "openai",
      "apiKeyEnv": "OPENAI_API_KEY",
      "models": [
        { "name": "gpt-5-2", "modelId": "gpt-5.2", "contextLength": 200000, "maxOutputTokens": 8192 }
      ]
    },
    {
      "type": "custom",
      "name": "local-openai-compatible",
      "baseUrl": "http://127.0.0.1:11434/v1",
      "apiKeyEnv": "LOCAL_LLM_API_KEY",
      "optional": true,
      "models": [
        { "name": "local-model", "modelId": "qwen2.5-coder:14b", "contextLength": 32768, "maxOutputTokens": 4096 }
      ]
    }
  ],
  "agents": {
    "primaryModel": "anthropic/claude-sonnet-5-5",
    "fallbackModel": "openai/gpt-5-2"
  },
  "connector": {
    "name": "vscode",
    "url": "http://127.0.0.1:47615/mcp"
  }
}
